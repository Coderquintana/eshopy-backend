{
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver;Database=EShopy.Prod;User Id=eshopy;Password=ChangeMe!;TrustServerCertificate=False;"
  },
  "Keycloak": {
    "Authority": "https://auth.eshopy.com.py/realms/eshopy",
    "Audience": "eshopy-api",
    "RequireHttpsMetadata": true,
    "ValidateIssuer": true,
    "ValidateAudience": true,
    "ValidateLifetime": true,
    "AdminBaseUrl": "https://auth.eshopy.com.py",
    "AdminClientId": "eshopy-api",
    "AdminClientSecret": "ChangeMe! (inject via secret store, never commit)"
  },
  "Auth": {
    "Authority": "https://auth.eshopy.com.py/realms/eshopy",
    "Audience": "eshopy-api"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://*.eshopy.com.py"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  }
}
