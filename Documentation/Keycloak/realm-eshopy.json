{
  "realm": "eshopy",
  "enabled": true,
  "displayName": "EShopy",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "rememberMe": true,
  "roles": {
    "realm": [
      { "name": "ESHOPY_SUPERADMIN", "description": "Administracion global del SaaS." },
      { "name": "TENANT_OWNER", "description": "Propietario del tenant." },
      { "name": "TENANT_ADMIN", "description": "Administrador del tenant." },
      { "name": "TENANT_STAFF", "description": "Staff operativo del tenant." },
      { "name": "tenants.read", "description": "Permiso: leer tenants." },
      { "name": "tenants.write", "description": "Permiso: modificar tenants." },
      { "name": "store.read", "description": "Permiso: leer configuracion de tienda." },
      { "name": "store.write", "description": "Permiso: modificar configuracion de tienda." },
      { "name": "catalog.read", "description": "Permiso: leer catalogo." },
      { "name": "catalog.write", "description": "Permiso: modificar catalogo." },
      { "name": "orders.read", "description": "Permiso: leer pedidos." },
      { "name": "orders.write", "description": "Permiso: modificar pedidos." },
      { "name": "payments.read", "description": "Permiso: leer pagos." },
      { "name": "users.manage", "description": "Permiso: administrar usuarios." },
      { "name": "billing.manage", "description": "Permiso: administrar billing." }
    ]
  },
  "defaultRoles": [
    "TENANT_STAFF",
    "store.read",
    "catalog.read",
    "orders.read"
  ],
  "users": [
    {
      "username": "superadmin@eshopy.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Super",
      "lastName": "Admin",
      "email": "superadmin@eshopy.local",
      "credentials": [
        { "type": "password", "value": "Admin123!", "temporary": false }
      ],
      "realmRoles": [
        "ESHOPY_SUPERADMIN",
        "TENANT_OWNER",
        "TENANT_ADMIN",
        "TENANT_STAFF",
        "tenants.read",
        "tenants.write",
        "store.read",
        "store.write",
        "catalog.read",
        "catalog.write",
        "orders.read",
        "orders.write",
        "payments.read",
        "users.manage",
        "billing.manage"
      ]
    },
    {
      "username": "owner@tenant1.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tenant",
      "lastName": "Owner",
      "email": "owner@tenant1.local",
      "credentials": [
        { "type": "password", "value": "Admin123!", "temporary": false }
      ],
      "realmRoles": [
        "TENANT_OWNER",
        "store.read",
        "store.write",
        "catalog.read",
        "catalog.write",
        "orders.read",
        "orders.write",
        "payments.read",
        "users.manage",
        "billing.manage"
      ]
    },
    {
      "username": "admin@tenant1.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tenant",
      "lastName": "Admin",
      "email": "admin@tenant1.local",
      "credentials": [
        { "type": "password", "value": "Admin123!", "temporary": false }
      ],
      "realmRoles": [
        "TENANT_ADMIN",
        "store.read",
        "catalog.read",
        "catalog.write",
        "orders.read",
        "orders.write",
        "payments.read"
      ]
    },
    {
      "username": "staff@tenant1.local",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Tenant",
      "lastName": "Staff",
      "email": "staff@tenant1.local",
      "credentials": [
        { "type": "password", "value": "Admin123!", "temporary": false }
      ],
      "realmRoles": [
        "TENANT_STAFF",
        "store.read",
        "catalog.read",
        "orders.read"
      ]
    },
    {
      "username": "service-account-eshopy-api",
      "enabled": true,
      "serviceAccountClientId": "eshopy-api",
      "clientRoles": {
        "realm-management": ["manage-users", "view-users"]
      }
    }
  ],
  "clients": [
    {
      "clientId": "eshopy-api",
      "name": "EShopy API",
      "enabled": true,
      "publicClient": false,
      "secret": "eshopy-api-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://localhost:5000/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://localhost:5000"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles",
        "permissions",
        "audience-eshopy-api"
      ]
    },
    {
      "clientId": "eshopy-postman",
      "name": "EShopy Postman (Dev)",
      "enabled": true,
      "publicClient": false,
      "secret": "postman-secret",
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false
    },
    {
      "clientId": "eshopy-admin",
      "name": "EShopy Admin (SPA)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    }
  ],
  "clientScopes": [
    {
      "name": "roles",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "permissions",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "realm-permissions",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "permissions",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "audience-eshopy-api",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-eshopy-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "eshopy-api",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "profile",
    "email",
    "roles",
    "permissions",
    "audience-eshopy-api"
  ]
}
