              "raw": "{\n  \"subdomain\": \"mitienda\",\n  \"businessName\": \"Mi Tienda SRL\",\n  \"ownerEmail\": \"owner@mitienda.com\",\n  \"ownerName\": \"Juan Perez\",\n  \"plan\": \"basic\"\n}"
            }
