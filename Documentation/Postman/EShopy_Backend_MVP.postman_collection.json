{
  "info": {
    "name": "EShopy Backend MVP",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleccion base de endpoints MVP. El tenant se resuelve por subdominio/host; no se envia TenantId desde el cliente."
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Get Access Token (Keycloak)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "grant_type",
                  "value": "password"
                },
                {
                  "key": "client_id",
                  "value": "{{kc_client_id}}"
                },
                {
                  "key": "client_secret",
                  "value": "{{kc_client_secret}}"
                },
                {
                  "key": "username",
                  "value": "{{kc_username}}"
                },
                {
                  "key": "password",
                  "value": "{{kc_password}}"
                }
              ]
            },
            "url": {
              "raw": "{{kc_base_url}}/realms/{{kc_realm}}/protocol/openid-connect/token",
              "host": [
                "{{kc_base_url}}"
              ],
              "path": [
                "realms",
                "{{kc_realm}}",
                "protocol",
                "openid-connect",
                "token"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json && json.access_token) {",
                  "  pm.environment.set('adminToken', json.access_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Overview",
      "description": "Variables sugeridas: baseUrl, api_root, adminToken, cartToken.\n- baseUrl (dev local): http://localhost:5000/api\n- api_root (dev local): http://localhost:5000\n- adminToken: Bearer JWT de Keycloak\n- cartToken: token de carrito anonimo\n\nConvenciones:\n- JSON UTF-8\n- Fechas ISO 8601 UTC\n- CorrelationId opcional en X-Correlation-Id",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{api_root}}/health",
              "host": [
                "{{api_root}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
