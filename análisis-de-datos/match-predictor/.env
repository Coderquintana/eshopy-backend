# API-Football (api-sports.io) — free tier ~100 req/día
# Registro: https://dashboard.api-sports.io/register
API_FOOTBALL_KEY=ae67981f4644a3a057958c17c61ac654

# football-data.org — free tier para top competitions
# Registro: https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=your_key_here

# IA opcional: Groq (free tier generoso, muy rápido)
# Registro: https://console.groq.com
GROQ_API_KEY=

# IA opcional: Google Gemini
GEMINI_API_KEY=

# Base de datos (SQLite por defecto, no cambiar salvo que quieras PostgreSQL)
DATABASE_URL=sqlite:///predictor.db

# Directorio de cache en disco para no quemar rate limits
CACHE_DIR=.cache

# Nivel de log: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Umbral de alerta de valor: diferencia mínima modelo vs casa para emitir alerta
VALUE_ALERT_THRESHOLD=0.08

# Puerto del servidor
PORT=5000
